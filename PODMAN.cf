# Project Firefly: Podman
# Fedora 44 + AOCCv6 Builder
FROM fedora:44 AS builder

RUN dnf install -y \
  git \
  golang \
  make \
  gcc \
  pkgconf-pkg-config \
  gpgme-devel \
  libassuan-devel \
  libseccomp-devel \
  device-mapper-devel \
  glib2-devel \
  libselinux-devel \
  systemd-devel \
  btrfs-progs-devel \
  go-md2man \
  libquadmath \
  ncurses \
  glibc-devel \
  && dnf clean all

COPY aocc-v6/aocc* /tmp/
RUN cat /tmp/aocc* > /tmp/aocc.rpm && \
  rpm -ivh --nodigest --nosignature /tmp/aocc.rpm && \
  rm -f /tmp/aocc*

ENV AOCC_DIR="/opt/AMD/aocc-compiler-6.0.0"
ENV PATH="${AOCC_DIR}/bin:${PATH}"
ENV LIBRARY_PATH="${AOCC_DIR}/lib:${AOCC_DIR}/lib32:${LIBRARY_PATH}"
ENV LD_LIBRARY_PATH="${AOCC_DIR}/lib:${AOCC_DIR}/lib32:${LD_LIBRARY_PATH}"

ENV GOPATH="/go" \
  GOMAXPROCS="16" \
  GOOS="linux" \
  GOARCH="amd64" \
  GOAMD64="v3" \
  CGO_ENABLED="1" \
  CC="aoc" \
  CXX="aoc++" \
  CGO_CFLAGS="-O3 -march=znver3 -mtune=znver3 -zopt -fvector-transform -fscalar-transform -floop-transform -faggressive-loop-transform -fremap-arrays -fstruct-layout=7 -fveclib=AMDLIBM" \
  CGO_CXXFLAGS="-O3 -march=znver3 -mtune=znver3 -zopt -fvector-transform -fscalar-transform -floop-transform -faggressive-loop-transform -fremap-arrays -fstruct-layout=7 -fveclib=AMDLIBM" \
  CGO_LDFLAGS="-fuse-ld=lld -l:libamdlibm.a"

FROM builder AS compiler
WORKDIR /tmp/podman-src

RUN git clone --depth 1 https://github.com/containers/podman.git . && \
  make BUILDTAGS="selinux seccomp systemd" binaries docs && \
  make BUILDTAGS="selinux seccomp systemd" \
    DESTDIR=/out \
    PREFIX=/usr \
    ETCDIR=/etc \
    install.bin \
    install.man \
    install.systemd \
    install.completions && \
  find /out/usr -maxdepth 4

FROM scratch AS export
COPY --from=compiler /out/usr/bin/ /usr/bin/
COPY --from=compiler /out/usr/libexec/ /usr/libexec/
COPY --from=compiler /out/usr/lib/ /usr/lib/
COPY --from=compiler /out/usr/share/man/ /usr/share/man/
COPY --from=compiler /out/usr/share/bash-completion/ /usr/share/bash-completion/
COPY --from=compiler /out/usr/share/zsh/ /usr/share/zsh/
