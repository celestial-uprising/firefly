# Project Firefly: buildah (Zen3+ / AOCC 6.0 CGO)
# Fedora 44 Builder
FROM fedora:44 AS builder

RUN dnf install -y \
  git \
  golang \
  make \
  gcc \
  pkgconf-pkg-config \
  gpgme-devel \
  libassuan-devel \
  libseccomp-devel \
  device-mapper-devel \
  glib2-devel \
  libselinux-devel \
  btrfs-progs-devel \
  sqlite-devel \
  shadow-utils-subid-devel \
  go-md2man \
  libquadmath \
  ncurses \
  && dnf clean all

COPY aocc-v6/aocc* /tmp/
RUN cat /tmp/aocc* > /tmp/aocc.rpm && \
    rpm -ivh --nodigest --nosignature /tmp/aocc.rpm && \
    rm -f /tmp/aocc*

ENV AOCC_DIR="/opt/AMD/aocc-compiler-6.0.0"
ENV PATH="${AOCC_DIR}/bin:${PATH}"
ENV LIBRARY_PATH="${AOCC_DIR}/lib:${AOCC_DIR}/lib32:${LIBRARY_PATH}"
ENV LD_LIBRARY_PATH="${AOCC_DIR}/lib:${AOCC_DIR}/lib32:${LD_LIBRARY_PATH}"

ENV GOPATH="/go" \
    GOMAXPROCS="16" \
    GOOS="linux" \
    GOARCH="amd64" \
    GOAMD64="v3" \
    CGO_ENABLED="1" \
    CC="aoc" \
    CXX="aoc++" \
    CGO_CFLAGS="-O3 -march=znver3 -mtune=znver3 -zopt -fscalar-transform -floop-transform -faggressive-loop-transform -fremap-arrays -fstruct-layout=7 -fveclib=AMDLIBM" \
    CGO_CXXFLAGS="-O3 -march=znver3 -mtune=znver3 -zopt -fscalar-transform -floop-transform -faggressive-loop-transform -fremap-arrays -fstruct-layout=7 -fveclib=AMDLIBM" \
    CGO_LDFLAGS="-fuse-ld=lld -l:libamdlibm.a"

FROM builder AS compiler
WORKDIR /build/buildah

RUN git clone --depth 1 https://github.com/containers/buildah.git . && \
    make -j16 BUILDTAGS="seccomp selinux libsqlite3" && \
    make -j16 DESTDIR=/out PREFIX=/usr install install.completions && \
    llvm-strip --strip-unneeded /out/usr/bin/buildah 2>/dev/null || true

FROM scratch AS export
COPY --from=compiler /out/ /