# Project Firefly: QEMU (Zen3+ / AOCC 6.0 + ld.lld + Static Runtime Preference)
# Fedora 44 Builder — bootc layout under /out/usr
FROM fedora:44 AS builder

RUN dnf install -y --setopt=tsflags=nodocs \
  git \
  ca-certificates \
  gcc \
  gcc-c++ \
  libstdc++-devel \
  libstdc++-static \
  libquadmath \
  libquadmath-static \
  lld \
  ncurses \
  ncurses-devel \
  meson \
  ninja-build \
  pkgconf-pkg-config \
  python3 \
  glib2-devel \
  pixman-devel \
  zlib-devel \
  libzstd-devel \
  libslirp-devel \
  libcap-ng-devel \
  libseccomp-devel \
  libselinux-devel \
  pam-devel \
  libattr-devel \
  libaio-devel \
  liburing-devel \
  libepoxy-devel \
  virglrenderer-devel \
  vulkan-loader-devel \
  mesa-vulkan-drivers \
  spice-server-devel \
  spice-protocol \
  SDL2-devel \
  SDL2_image-devel \
  pipewire-devel \
  usbredir-devel \
  libusb1-devel \
  gnutls-devel \
  libssh-devel \
  libcurl-devel \
  jemalloc-devel \
  capstone-devel \
  dtc \
  libfdt-devel \
  && dnf clean all

COPY aocc-v6/aocc* /tmp/
RUN cat /tmp/aocc* > /tmp/aocc.rpm && \
    rpm -ivh --nodigest --nosignature /tmp/aocc.rpm && \
    rm -f /tmp/aocc*

ENV AOCC_DIR="/opt/AMD/aocc-compiler-6.0.0"
ENV PATH="${AOCC_DIR}/bin:${PATH}" \
    LIBRARY_PATH="${AOCC_DIR}/lib:${AOCC_DIR}/lib32:${LIBRARY_PATH}" \
    LD_LIBRARY_PATH="${AOCC_DIR}/lib:${AOCC_DIR}/lib32:${LD_LIBRARY_PATH}" \
    C_INCLUDE_PATH="${AOCC_DIR}/include:${C_INCLUDE_PATH}" \
    CPLUS_INCLUDE_PATH="${AOCC_DIR}/include:${CPLUS_INCLUDE_PATH}"

ENV CC="aoc" \
    CXX="aoc++" \
    LD="ld.lld" \
    AR="llvm-ar" \
    RANLIB="llvm-ranlib" \
    NM="llvm-nm" \
    STRIP="llvm-strip" \
    CFLAGS="-O3 -march=znver3 -mtune=znver3 -flto=full -zopt -fscalar-transform -floop-transform -faggressive-loop-transform -fremap-arrays -fstruct-layout=7 -fveclib=AMDLIBM" \
    CXXFLAGS="-O3 -march=znver3 -mtune=znver3 -flto=full -zopt -fscalar-transform -floop-transform -faggressive-loop-transform -fremap-arrays -fstruct-layout=7 -fveclib=AMDLIBM" \
    LDFLAGS="-fuse-ld=lld -flto=full -O3 -static-libstdc++ -static-libgcc -Wl,-O3,--gc-sections,--as-needed,--no-fatal-warnings -l:libamdlibm.a"

FROM builder AS compiler
WORKDIR /build/qemu

RUN mkdir -p /out && \
    git clone --depth 1 https://gitlab.com/qemu-project/qemu.git . && \
    ./configure \
      --prefix=/usr \
      --bindir=/usr/bin \
      --libexecdir=/usr/libexec \
      --libdir=/usr/lib64 \
      --sysconfdir=/etc \
      --localstatedir=/var \
      --cc="${CC}" \
      --cxx="${CXX}" \
      --extra-cflags="${CFLAGS}" \
      --extra-cxxflags="${CXXFLAGS}" \
      --extra-ldflags="${LDFLAGS}" \
      --target-list=x86_64-softmmu,aarch64-softmmu,riscv64-softmmu \
      --enable-kvm \
      --enable-lto \
      --enable-zstd \
      --enable-slirp \
      --enable-cap-ng \
      --enable-seccomp \
      --enable-libusb \
      --enable-spice \
      --enable-virglrenderer \
      --enable-opengl \
      --enable-tools \
      --disable-xen \
      --disable-docs \
      --disable-werror && \
    for opt in \
      "-Ddefault_devices=true" \
      "-Dmalloc=jemalloc" \
      "-Dselinux=enabled" \
      "-Dpam=enabled" \
      "-Dcurses=enabled" \
      "-Dvnc=enabled" \
      "-Dusb_redir=enabled" \
      "-Dsdl=enabled" \
      "-Dsdl_image=enabled" \
      "-Dvulkan=enabled" \
      "-Dcapstone=enabled" \
      "-Dfdt=enabled"; do \
      meson configure build "$opt" || echo "WARN: skipped $opt"; \
    done && \
    ninja -C build -j16 && \
    DESTDIR=/out ninja -C build install && \
    if [ -d /out/usr/sbin ] && [ ! -L /out/usr/sbin ]; then \
      mkdir -p /out/usr/bin && cp -a /out/usr/sbin/. /out/usr/bin/ && rm -rf /out/usr/sbin; \
    fi && \
    rm -rf /out/usr/include /out/usr/lib64/pkgconfig /out/usr/lib64/*.a /out/usr/lib/*.a /out/usr/.crates.toml /out/usr/.crates2.json && \
    find /out/usr -type f \( -executable -o -name "*.so*" \) -exec llvm-strip --strip-unneeded {} + 2>/dev/null || true && \
    for bin in /out/usr/bin/*; do \
      if [ -f "$bin" ] && [ -x "$bin" ] && head -c 4 "$bin" 2>/dev/null | grep -q $'\x7fELF'; then \
        echo "=== NEEDED: $(basename "$bin") ==="; \
        readelf -d "$bin" | awk '/NEEDED/ {print $5}' || true; \
      fi; \
    done

FROM scratch AS export
COPY --from=compiler /out/ /
