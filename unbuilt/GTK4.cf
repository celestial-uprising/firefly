# Project Firefly: gtk4 (Zen3+ / AOCC 6.0)
# Fedora 44 Builder -> Push to ghcr.io/celestial-uprising/firefly:gtk4
FROM fedora:44 AS builder

RUN dnf install -y \
  git \
  gcc \
  meson \
  ninja-build \
  pkgconf-pkg-config \
  gettext \
  gobject-introspection-devel \
  glib2-devel \
  cairo-devel \
  pango-devel \
  gdk-pixbuf2-devel \
  graphene-devel \
  libepoxy-devel \
  wayland-devel \
  wayland-protocols-devel \
  libxkbcommon-devel \
  vulkan-headers \
  vulkan-loader-devel \
  glslc \
  mesa-libGL-devel \
  mesa-libEGL-devel \
  mesa-libgbm-devel \
  libdrm-devel \
  libX11-devel \
  libXrandr-devel \
  libXi-devel \
  libXext-devel \
  libXcursor-devel \
  libXdamage-devel \
  libXfixes-devel \
  libXinerama-devel \
  libjpeg-turbo-devel \
  libpng-devel \
  libtiff-devel \
  cups-devel \
  colord-devel \
  gstreamer1-devel \
  gstreamer1-plugins-base-devel \
  gstreamer1-plugins-bad-free-devel \
  python3-docutils \
  libquadmath \
  ncurses \
  && dnf clean all

COPY aocc-v6/aocc* /tmp/
RUN cat /tmp/aocc* > /tmp/aocc.rpm && \
    rpm -ivh --nodigest --nosignature /tmp/aocc.rpm && \
    rm -f /tmp/aocc*

ENV AOCC_DIR="/opt/AMD/aocc-compiler-6.0.0"
ENV PATH="${AOCC_DIR}/bin:${PATH}"
ENV LIBRARY_PATH="${AOCC_DIR}/lib:${AOCC_DIR}/lib32:${LIBRARY_PATH}"
ENV LD_LIBRARY_PATH="${AOCC_DIR}/lib:${AOCC_DIR}/lib32:${LD_LIBRARY_PATH}"
ENV C_INCLUDE_PATH="${AOCC_DIR}/include:${C_INCLUDE_PATH}"
ENV CPLUS_INCLUDE_PATH="${AOCC_DIR}/include:${CPLUS_INCLUDE_PATH}"

ENV CC="aoc" \
    CXX="aoc++" \
    AR="llvm-ar" \
    RANLIB="llvm-ranlib" \
    NM="llvm-nm" \
    STRIP="llvm-strip" \
    CFLAGS="-O3 -march=znver3 -mtune=znver3 -flto=full -zopt -fscalar-transform -floop-transform -faggressive-loop-transform -fremap-arrays -fstruct-layout=7 -fveclib=AMDLIBM" \
    CXXFLAGS="-O3 -march=znver3 -mtune=znver3 -flto=full -zopt -fscalar-transform -floop-transform -faggressive-loop-transform -fremap-arrays -fstruct-layout=7 -fveclib=AMDLIBM" \
    LDFLAGS="-fuse-ld=lld -flto=full -O3 -l:libamdlibm.a"

FROM builder AS compiler
WORKDIR /build/gtk

RUN git clone --depth 1 https://gitlab.gnome.org/GNOME/gtk.git . && \
    meson setup build \
      --buildtype=release \
      --prefix=/usr \
      -Dwayland-backend=true \
      -Dx11-backend=true \
      -Dvulkan=enabled \
      -Dmedia-gstreamer=enabled \
      -Dprint-cups=enabled \
      -Dintrospection=enabled \
      -Dbuild-tests=false \
      -Dbuild-testsuite=false \
      -Dbuild-examples=false \
      -Dbuild-demos=false && \
    ninja -C build -j16 && \
    DESTDIR=/out ninja -C build install && \
    find /out/usr/bin /out/usr/lib64 -type f \( -name "*.so*" -o -executable \) -exec llvm-strip --strip-unneeded {} + 2>/dev/null || true

FROM scratch AS export
COPY --from=compiler /out/ /