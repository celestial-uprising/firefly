# Project Firefly: Pi-Bolt (Runtime from Source)
# Fedora 44 + Zen3+ Builder
FROM fedora:44 AS builder

RUN dnf install -y \
    git \
    curl \
    unzip \
    xz \
    tar \
    rsync \
    cmake \
    ninja-build \
    python3 \
    nodejs \
    npm \
    gcc \
    gcc-c++ \
    libquadmath \
    ncurses \
    && dnf clean all

COPY aocc-v6/aocc* /tmp/
RUN cat /tmp/aocc* > /tmp/aocc.rpm && \
    rpm -ivh --nodigest --nosignature /tmp/aocc.rpm && \
    rm -f /tmp/aocc*

ENV AOCC_DIR="/opt/AMD/aocc-compiler-6.0.0"
ENV PATH="${AOCC_DIR}/bin:${PATH}"
ENV LIBRARY_PATH="${AOCC_DIR}/lib:${AOCC_DIR}/lib32:${LIBRARY_PATH}"
ENV LD_LIBRARY_PATH="${AOCC_DIR}/lib:${AOCC_DIR}/lib32:${LD_LIBRARY_PATH}"
ENV C_INCLUDE_PATH="${AOCC_DIR}/include:${C_INCLUDE_PATH}"
ENV CPLUS_INCLUDE_PATH="${AOCC_DIR}/include:${CPLUS_INCLUDE_PATH}"

ENV BUN_INSTALL="/root/.bun" \
    PATH="/root/.bun/bin:${PATH}" \
    MAKEFLAGS="-j16" \
    CMAKE_BUILD_PARALLEL_LEVEL="16" \
    NINJA_STATUS="[%f/%t] " \
    CC="aoc" \
    CXX="aoc++" \
    AR="llvm-ar" \
    RANLIB="llvm-ranlib" \
    NM="llvm-nm" \
    STRIP="llvm-strip" \
    LD="ld.lld" \
    CFLAGS="-O3 -march=znver3 -mtune=znver3 -zopt -fscalar-transform -floop-transform -faggressive-loop-transform -fremap-arrays -fstruct-layout=7 -fveclib=AMDLIBM" \
    CXXFLAGS="-O3 -march=znver3 -mtune=znver3 -zopt -fscalar-transform -floop-transform -faggressive-loop-transform -fremap-arrays -fstruct-layout=7 -fveclib=AMDLIBM" \
    LDFLAGS="-fuse-ld=lld -Wl,-O3,--gc-sections,--as-needed -l:libamdlibm.a"

RUN curl -fsSL "https://bun.sh/install" | bash && \
    bun --version

FROM builder AS compiler
WORKDIR /build
RUN mkdir -p /out/usr/bin /out/usr/lib/pi-bolt

RUN git clone https://github.com/opensec-git/Pi-Bolt.git /build/Pi-Bolt
WORKDIR /build/Pi-Bolt

RUN bash scripts/fetch-sources.sh && \
    bash scripts/build-runtime.sh --native && \
    bash scripts/prepare-pi.sh && \
    bash scripts/build-pi.sh --cpu native && \
    cp -a out/pi-bolt/. /out/usr/lib/pi-bolt/ && \
    ln -sf /usr/lib/pi-bolt/pi /out/usr/bin/pi && \
    /out/usr/lib/pi-bolt/pi --version

FROM scratch AS export
COPY --from=compiler /out/ /
