# Project Firefly: Crun
# Fedora 44 + Zen3+ Builder
FROM fedora:44 AS builder
RUN dnf install -y \
    git make cmake ninja-build meson autoconf automake libtool \
    pkgconf-pkg-config bison flex gperf texinfo nasm glibc-devel \
    libstdc++-devel autoconf automake gcc git-core glibc-static \
    libcap-devel libseccomp-devel libtool make pkg-config python \
    python-libmount systemd-devel json-c-devel libquadmath ncurses \
    && dnf clean all
COPY aocc-v6/aocc* /tmp/
RUN cat /tmp/aocc* > /tmp/aocc.rpm && \
    rpm -ivh --nodigest --nosignature /tmp/aocc.rpm && \
    rm -f /tmp/aocc*
ENV AOCC_DIR="/opt/AMD/aocc-compiler-6.0.0"
ENV PATH="${AOCC_DIR}/bin:${PATH}"
ENV LIBRARY_PATH="${AOCC_DIR}/lib:${AOCC_DIR}/lib32:${LIBRARY_PATH}"
ENV LD_LIBRARY_PATH="${AOCC_DIR}/lib:${AOCC_DIR}/lib32:${LD_LIBRARY_PATH}"
ENV C_INCLUDE_PATH="${AOCC_DIR}/include:${C_INCLUDE_PATH}"
ENV CPLUS_INCLUDE_PATH="${AOCC_DIR}/include:${CPLUS_INCLUDE_PATH}"
ENV CC="aoc" \
    CXX="aoc++" \
    AR="llvm-ar" \
    NM="llvm-nm" \
    RANLIB="llvm-ranlib" \
    STRIP="llvm-strip" \
    LD="ld.lld" \
    MAKEFLAGS="-j16" \
    CMAKE_BUILD_PARALLEL_LEVEL="16" \
    NINJA_STATUS="[%f/%t] "

ENV CFLAGS="-O3 -march=znver3 -mtune=znver3 -flto -zopt -fvector-transform -fscalar-transform -floop-transform -faggressive-loop-transform -fremap-arrays -fstruct-layout=7 -fveclib=AMDLIBM" \
    CXXFLAGS="-O3 -march=znver3 -mtune=znver3 -flto -zopt -fvector-transform -fscalar-transform -floop-transform -faggressive-loop-transform -fremap-arrays -fstruct-layout=7 -fveclib=AMDLIBM" \
    LDFLAGS="-fuse-ld=lld -flto -Wl,-O3,--gc-sections,--as-needed -l:libamdlibm.a"

FROM builder AS compiler
WORKDIR /build
RUN mkdir -p /out/bin /out/lib64 /out/share

RUN git clone --depth 1 https://github.com/containers/crun.git && \
     cd crun && \
     ./autogen.sh && \
     ./configure --prefix=/out && \
     make && \
     make install && \
     llvm-strip --strip-unneeded /out/bin/*

RUN rm -rf /out/include /out/lib64/pkgconfig /out/lib64/*.a /out/lib/*.a

FROM scratch AS export
COPY --from=compiler /out/bin/ /usr/bin/
COPY --from=compiler /out/lib64/ /usr/local/lib64/
COPY --from=compiler /out/share/ /usr/share/
# Uncomment below if any of your C projects install shared libraries (.so) or manpages/data:

