# Project Firefly: <PACKAGE_NAME>
# Target: x86_64 Zen 3 on Fedora 44 with AOCC 6.0

FROM fedora:44 AS builder

RUN dnf install -y --setopt=tsflags=nodocs \
    git curl ca-certificates make cmake ninja-build meson \
    pkgconf-pkg-config gcc gcc-c++ libstdc++-devel libquadmath \
    && dnf clean all

COPY aocc-v6/aocc* /tmp/
RUN cat /tmp/aocc* > /tmp/aocc.rpm && \
    rpm -ivh --nodigest --nosignature /tmp/aocc.rpm && \
    rm -f /tmp/aocc*

ENV AOCC_DIR="/opt/AMD/aocc-compiler-6.0.0"
ENV PATH="${AOCC_DIR}/bin:${PATH}" \
    LIBRARY_PATH="${AOCC_DIR}/lib:${AOCC_DIR}/lib32:${LIBRARY_PATH}" \
    LD_LIBRARY_PATH="${AOCC_DIR}/lib:${AOCC_DIR}/lib32:${LD_LIBRARY_PATH}" \
    C_INCLUDE_PATH="${AOCC_DIR}/include:${C_INCLUDE_PATH}" \
    CPLUS_INCLUDE_PATH="${AOCC_DIR}/include:${CPLUS_INCLUDE_PATH}"

ENV CC="aoc" \
    CXX="aoc++" \
    LD="ld.lld" \
    AR="llvm-ar" \
    RANLIB="llvm-ranlib" \
    NM="llvm-nm" \
    STRIP="llvm-strip"

FROM builder AS compiler

WORKDIR /build/src
RUN git clone --depth 1 <UPSTREAM_REPO_URL> .

RUN CFLAGS="-O3 -march=znver3 -mtune=znver3 -flto=full -zopt -fveclib=AMDLIBM" \
    CXXFLAGS="-O3 -march=znver3 -mtune=znver3 -flto=full -zopt -fveclib=AMDLIBM" \
    LDFLAGS="-fuse-ld=lld -flto=full -O3 -l:libamdlibm.a" \
    cmake -B build -G Ninja \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX=/usr \
      -DCMAKE_INSTALL_LIBDIR=lib64 \
      -DCMAKE_INSTALL_SBINDIR=bin && \
    ninja -C build -j"$(nproc)" && \
    DESTDIR=/out ninja -C build install

# Normalize any stray /out/usr/sbin -> /out/usr/bin and strip binaries
RUN if [ -d /out/usr/sbin ] && [ ! -L /out/usr/sbin ]; then \
      mkdir -p /out/usr/bin && cp -a /out/usr/sbin/. /out/usr/bin/ && rm -rf /out/usr/sbin; \
    fi && \
    find /out/usr/bin /out/usr/lib64 -type f \( -executable -o -name "*.so*" \) \
      -exec llvm-strip --strip-unneeded {} + 2>/dev/null || true

FROM scratch AS export
COPY --from=compiler /out/ /
