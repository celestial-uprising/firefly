# Project Firefly: mpv (Zen3+ / AOCC 6.0)
# Fedora 44 Builder using custom ffmpeg + libplacebo (>=7.387.0)
FROM ghcr.io/celestial-uprising/firefly:ffmpeg AS ffmpeg-artifacts
FROM ghcr.io/celestial-uprising/firefly:libplacebo AS libplacebo-artifacts

FROM fedora:44 AS builder

RUN dnf install -y \
  git \
  gcc \
  gcc-c++ \
  libstdc++-devel \
  cmake \
  meson \
  ninja-build \
  pkgconf-pkg-config \
  libva-devel \
  openssl-devel \
  libass-devel \
  vulkan-devel \
  glslang-devel \
  spirv-tools-devel \
  libshaderc-devel \
  lcms2-devel \
  libdovi-devel \
  xxhash-devel \
  libxkbcommon-devel \
  wayland-devel \
  wayland-protocols-devel \
  mesa-libgbm-devel \
  libdrm-devel \
  libX11-devel \
  libXext-devel \
  libXrandr-devel \
  libXpresent-devel \
  pipewire-devel \
  alsa-lib-devel \
  libquadmath \
  ncurses \
  && dnf clean all

COPY aocc-v6/aocc* /tmp/
RUN cat /tmp/aocc* > /tmp/aocc.rpm && \
    rpm -ivh --nodigest --nosignature /tmp/aocc.rpm && \
    rm -f /tmp/aocc*

ENV AOCC_DIR="/opt/AMD/aocc-compiler-6.0.0"
ENV PATH="${AOCC_DIR}/bin:${PATH}"
ENV LIBRARY_PATH="${AOCC_DIR}/lib:${AOCC_DIR}/lib32:${LIBRARY_PATH}"
ENV LD_LIBRARY_PATH="${AOCC_DIR}/lib:${AOCC_DIR}/lib32:${LD_LIBRARY_PATH}"
ENV C_INCLUDE_PATH="${AOCC_DIR}/include:${C_INCLUDE_PATH}"
ENV CPLUS_INCLUDE_PATH="${AOCC_DIR}/include:${CPLUS_INCLUDE_PATH}"

ENV CC="aoc" \
    CXX="aoc++" \
    AR="llvm-ar" \
    RANLIB="llvm-ranlib" \
    NM="llvm-nm" \
    STRIP="llvm-strip" \
    CFLAGS="-O3 -march=znver3 -mtune=znver3 -flto=full -zopt -fscalar-transform -floop-transform -faggressive-loop-transform -fremap-arrays -fstruct-layout=7 -fveclib=AMDLIBM" \
    CXXFLAGS="-O3 -march=znver3 -mtune=znver3 -flto=full -zopt -fscalar-transform -floop-transform -faggressive-loop-transform -fremap-arrays -fstruct-layout=7 -fveclib=AMDLIBM" \
    LDFLAGS="-fuse-ld=lld -flto=full -O3 -l:libamdlibm.a -lstdc++ -lSPIRV-Tools -lSPIRV-Tools-opt"

FROM builder AS compiler
COPY --from=ffmpeg-artifacts /usr/local/ /usr/local/
COPY --from=libplacebo-artifacts /usr/local/ /usr/local/

ENV PKG_CONFIG_PATH="/usr/local/lib/pkgconfig:/usr/local/lib64/pkgconfig:${PKG_CONFIG_PATH}" \
    LIBRARY_PATH="/usr/local/lib:/usr/local/lib64:${LIBRARY_PATH}" \
    LD_LIBRARY_PATH="/usr/local/lib:/usr/local/lib64:${LD_LIBRARY_PATH}"

WORKDIR /build/mpv
RUN git clone --depth 1 https://github.com/mpv-player/mpv.git . && \
    meson setup build \
      --buildtype=release \
      --prefix=/usr \
      -Dprefer_static=true \
      -Dwayland=enabled \
      -Dvulkan=enabled && \
    ninja -C build -j16 && \
    DESTDIR=/out ninja -C build install && \
    llvm-strip --strip-unneeded /out/usr/bin/mpv 2>/dev/null || true

FROM scratch AS export
COPY --from=compiler /out/ /
