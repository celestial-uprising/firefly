# Project Firefly: Intent-Graph
# Fedora 44 + Zen3+ Builder
FROM fedora:44 AS builder
RUN dnf install -y \
    curl \
    git \
    make \
    cmake \
    ninja-build \
    meson \
    autoconf \
    automake \
    libtool \
    pkgconf-pkg-config \
    bison \
    flex \
    gperf \
    texinfo \
    nasm \
    glibc-devel \
    libstdc++-devel \
    gcc \
    git-core \
    glibc-static \
    libcap-devel \
    libseccomp-devel \
    python \
    python-libmount \
    systemd-devel \
    json-c-devel \
    libquadmath \
    ncurses \
    nodejs \
    pnpm \
    && dnf clean all

COPY aocc-v6/aocc* /tmp/
RUN cat /tmp/aocc* > /tmp/aocc.rpm && \
    rpm -ivh --nodigest --nosignature /tmp/aocc.rpm && \
    rm -f /tmp/aocc*

ENV AOCC_DIR="/opt/AMD/aocc-compiler-6.0.0"
ENV PATH="${AOCC_DIR}/bin:${PATH}"
ENV LIBRARY_PATH="${AOCC_DIR}/lib:${AOCC_DIR}/lib32:${LIBRARY_PATH}"
ENV LD_LIBRARY_PATH="${AOCC_DIR}/lib:${AOCC_DIR}/lib32:${LD_LIBRARY_PATH}"
ENV C_INCLUDE_PATH="${AOCC_DIR}/include:${C_INCLUDE_PATH}"
ENV CPLUS_INCLUDE_PATH="${AOCC_DIR}/include:${CPLUS_INCLUDE_PATH}"

ENV RUSTUP_HOME="/usr/local/rustup"
ENV CARGO_HOME="/usr/local/cargo"
ENV PATH="/usr/local/cargo/bin:${PATH}"

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
    sh -s -- -y --default-toolchain nightly --profile minimal && \
    rustup component add rust-src --toolchain nightly

ENV CARGO_BUILD_TARGET="x86_64-unknown-linux-gnu" \
    CARGO_BUILD_JOBS="16" \
    CARGO_INSTALL_ROOT="/out" \
    CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER="aoc" \
    CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_RUSTFLAGS="-C target-cpu=znver3 -C link-arg=-fuse-ld=lld -C link-arg=-l:libamdlibm.a -Z threads=16" \
    CARGO_UNSTABLE_BUILD_STD="std,panic_abort" \
    CARGO_UNSTABLE_PANIC_IMMEDIATE_ABORT="true" \
    CARGO_UNSTABLE_PROFILE_RUSTFLAGS="true" \
    CARGO_PROFILE_RELEASE_OPT_LEVEL="3" \
    CARGO_PROFILE_RELEASE_LTO="fat" \
    CARGO_PROFILE_RELEASE_CODEGEN_UNITS="1" \
    CARGO_PROFILE_RELEASE_PANIC="abort" \
    CARGO_PROFILE_RELEASE_STRIP="symbols" \
    CC="aoc" \
    CXX="aoc++" \
    AR="llvm-ar" \
    RANLIB="llvm-ranlib" \
    NM="llvm-nm" \
    STRIP="llvm-strip" \
    LD="ld.lld" \
    MAKEFLAGS="-j16" \
    CMAKE_BUILD_PARALLEL_LEVEL="16" \
    NINJA_STATUS="[%f/%t] " \
    CFLAGS="-O3 -march=znver3 -mtune=znver3 -flto -zopt -fvector-transform -fscalar-transform -floop-transform -faggressive-loop-transform -fremap-arrays -fstruct-layout=7 -fveclib=AMDLIBM" \
    CXXFLAGS="-O3 -march=znver3 -mtune=znver3 -flto -zopt -fvector-transform -fscalar-transform -floop-transform -faggressive-loop-transform -fremap-arrays -fstruct-layout=7 -fveclib=AMDLIBM" \
    LDFLAGS="-fuse-ld=lld -flto -Wl,-O3,--gc-sections,--as-needed -l:libamdlibm.a" \
    PKG_CONFIG_PATH="/usr/lib64/pkgconfig:/usr/share/pkgconfig" \
    PKG_CONFIG_LIBDIR="/usr/lib64/pkgconfig:/usr/share/pkgconfig" \
    PKG_CONFIG_ALLOW_SYSTEM_CFLAGS="0" \
    PKG_CONFIG_ALLOW_SYSTEM_LIBS="0" \
    LIBZ_SYS_STATIC="1" \
    LIBZSTD_NO_PKG_CONFIG="1" \
    BZIP2_SYS_STATIC="1" \
    LZMA_API_STATIC="1" \
    OPENSSL_NO_VENDOR="0" \
    OPENSSL_STATIC="1" \
    SODIUM_USE_PKG_CONFIG="0" \
    SODIUM_STATIC="1" \
    CURL_STATIC="1" \
    LIBSSH2_SYS_USE_PKG_CONFIG="0" \
    LIBGIT2_NO_PKG_CONFIG="1" \
    LIBNGHTTP2_NO_PKG_CONFIG="1" \
    SQLITE3_STATIC="1" \
    DUCKDB_STATIC="1" \
    PQ_LIB_STATIC="1" \
    RUSTONIG_SYSTEM_LIBONIG="0" \
    RUSTONIG_STATIC_LIBONIG="1" \
    SDL2_STATIC="1" \
    FREETYPE_SYS_STATIC="1" \
    HARFBUZZ_SYS_NO_PKG_CONFIG="1" \
    OPUS_STATIC="1" \
    LIBOPUS_NO_PKG_CONFIG="1"

FROM builder AS compiler
WORKDIR /build
RUN mkdir -p /out/bin /out/lib64 /out/share

RUN git clone https://github.com/mrzdevcore/intent-graph && \
    cd intent-graph && \
    make && \
    make PREFIX=/out install && \
    llvm-strip --strip-unneeded /out/bin/ig

RUN rm -rf /out/include /out/lib64/pkgconfig /out/lib64/*.a /out/lib/*.a

FROM scratch AS export
COPY --from=compiler /out/bin/ /usr/bin/
COPY --from=compiler /out/lib64/ /usr/local/lib64/
COPY --from=compiler /out/share/ /usr/share/
