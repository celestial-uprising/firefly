# Project Firefly: Solipsist
# Fedora 44 + Zen3+ Builder
FROM fedora:44 AS builder
RUN dnf install -y \
    git \
    curl \
    xz \
    tar \
    llvm \
    perl-Digest-SHA \
    && dnf clean all
ENV BUN_INSTALL="/root/.bun" \
    PATH="/root/.bun/bin:${PATH}" \
    MAKEFLAGS="-j16" \
    RAYON_NUM_THREADS="16"
RUN curl -fsSL "https://bun.sh/install" | bash && \
    bun --version
FROM builder AS compiler
WORKDIR /build
RUN mkdir -p /out/usr/bin /out/usr/lib/solipsist
RUN git clone https://github.com/pulkitsharma07/solipsist.git /build/solipsist
WORKDIR /build/solipsist

# ---- INSERT BUILD COMMANDS HERE ----
# The repository uses Cargo (Rust) for building. Adjust if a different
# build system is required.
RUN cargo build --release

# Copy the built binary and any needed libraries into /out
RUN cp target/release/solipsist /out/usr/bin/ && \
    # If the binary depends on shared libs, copy them as well.
    # This example copies everything under target/release/deps that
    # looks like a shared library.
    mkdir -p /out/usr/lib/solipsist && \
    cp -a target/release/deps/*.so* /out/usr/lib/solipsist/ 2>/dev/null || true

# If the runtime needs Bun, copy the Bun installation into /out
RUN cp -r /root/.bun /out/root/.bun

FROM scratch AS export
COPY --from=compiler /out/ /
