# Project Firefly: neovim
# Fedora 44 + Zen3+ Builder
FROM fedora:44 AS builder

RUN dnf install -y \
  git \
  gcc \
  gcc-c++ \
  cmake \
  ninja-build \
  unzip \
  gettext \
  curl \
  glibc-gconv-extra \
  pkgconf-pkg-config \
  libquadmath \
  ncurses \
  && dnf clean all

COPY aocc-v6/aocc* /tmp/
RUN cat /tmp/aocc* > /tmp/aocc.rpm && \
    rpm -ivh --nodigest --nosignature /tmp/aocc.rpm && \
    rm -f /tmp/aocc*

ENV AOCC_DIR="/opt/AMD/aocc-compiler-6.0.0"
ENV PATH="${AOCC_DIR}/bin:${PATH}"
ENV LIBRARY_PATH="${AOCC_DIR}/lib:${AOCC_DIR}/lib32:${LIBRARY_PATH}"
ENV LD_LIBRARY_PATH="${AOCC_DIR}/lib:${AOCC_DIR}/lib32:${LD_LIBRARY_PATH}"
ENV C_INCLUDE_PATH="${AOCC_DIR}/include:${C_INCLUDE_PATH}"
ENV CPLUS_INCLUDE_PATH="${AOCC_DIR}/include:${CPLUS_INCLUDE_PATH}"

ENV CC="aoc" \
    CXX="aoc++" \
    AR="llvm-ar" \
    RANLIB="llvm-ranlib" \
    CFLAGS="-O3 -march=znver3 -mtune=znver3 -zopt -fscalar-transform -floop-transform -faggressive-loop-transform -fremap-arrays -fstruct-layout=7 -fveclib=AMDLIBM" \
    CXXFLAGS="-O3 -march=znver3 -mtune=znver3 -zopt -fscalar-transform -floop-transform -faggressive-loop-transform -fremap-arrays -fstruct-layout=7 -fveclib=AMDLIBM" \
    LDFLAGS="-fuse-ld=lld -l:libamdlibm.a"

FROM builder AS compiler
WORKDIR /build/neovim
RUN git clone --depth 1 https://github.com/neovim/neovim.git . && \
    cmake -S cmake.deps -B .deps -G Ninja -DCMAKE_BUILD_TYPE=Release && \
    cmake --build .deps -j16 && \
    cmake -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr && \
    cmake --build build -j16 && \
    DESTDIR=/out cmake --install build && \
    if [ -d /out/usr/sbin ] && [ ! -L /out/usr/sbin ]; then \
      mkdir -p /out/usr/bin && cp -a /out/usr/sbin/. /out/usr/bin/ && rm -rf /out/usr/sbin; \
    fi && \
    find /out/usr/bin /out/usr/lib* -type f \
      \( -executable -o -name "*.so*" \) -exec llvm-strip --strip-unneeded {} + 2>/dev/null || true

FROM scratch AS export
COPY --from=compiler /out/ /
