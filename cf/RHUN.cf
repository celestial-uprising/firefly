# Project Firefly: Rhun
# Fedora 44 Assembly Builder
FROM fedora:44 AS builder
RUN dnf install -y \
    git \
    binutils \
    diffutils \
    && dnf clean all

ENV MAKEFLAGS="-j16"

FROM builder AS compiler
WORKDIR /build
RUN mkdir -p /out/usr/bin /out/usr/share/applications /out/usr/share/icons/hicolor

RUN git clone --depth 1 https://github.com/vshvedov/rhun.git /build/rhun
WORKDIR /build/rhun

# Build stripped release binary and stage binary + desktop assets
RUN ./build.sh release && \
    cp -a /build/rhun/build/rhun /out/usr/bin/rhun && \
    if [ -d /out/usr/sbin ] && [ ! -L /out/usr/sbin ]; then \
      cp -a /out/usr/sbin/. /out/usr/bin/ && rm -rf /out/usr/sbin; \
    fi && \
    find /build/rhun/assets -maxdepth 3 -ls

FROM scratch AS export
COPY --from=compiler /out/ /
