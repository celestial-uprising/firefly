# Project Firefly: git (Max Optimization)
# Fedora 44 + Zen3+ Builder
FROM fedora:44 AS builder

RUN dnf install -y \
  git \
  gcc \
  make \
  diffutils \
  perl \
  gettext \
  bison \
  flex \
  pkgconf-pkg-config \
  zlib-devel \
  openssl-devel \
  curl-devel \
  expat-devel \
  pcre2-devel \
  libquadmath \
  ncurses \
  && dnf clean all

COPY aocc-v6/aocc* /tmp/
RUN cat /tmp/aocc* > /tmp/aocc.rpm && \
    rpm -ivh --nodigest --nosignature /tmp/aocc.rpm && \
    rm -f /tmp/aocc*

ENV AOCC_DIR="/opt/AMD/aocc-compiler-6.0.0"
ENV PATH="${AOCC_DIR}/bin:${PATH}"
ENV LIBRARY_PATH="${AOCC_DIR}/lib:${AOCC_DIR}/lib32:${LIBRARY_PATH}"
ENV LD_LIBRARY_PATH="${AOCC_DIR}/lib:${AOCC_DIR}/lib32:${LD_LIBRARY_PATH}"
ENV C_INCLUDE_PATH="${AOCC_DIR}/include:${C_INCLUDE_PATH}"
ENV CPLUS_INCLUDE_PATH="${AOCC_DIR}/include:${CPLUS_INCLUDE_PATH}"

ENV RUSTUP_HOME="/usr/local/rustup"
ENV CARGO_HOME="/usr/local/cargo"
ENV PATH="/usr/local/cargo/bin:${PATH}"

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
    sh -s -- -y --default-toolchain nightly --profile minimal && \
    rustup component add rust-src --toolchain nightly

ENV CARGO_BUILD_TARGET="x86_64-unknown-linux-gnu" \
    CARGO_BUILD_JOBS="16" \
    CARGO_INSTALL_ROOT="/out" \
    CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER="aoc" \
    CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_RUSTFLAGS="-C target-cpu=znver3 -C link-arg=-fuse-ld=lld -C link-arg=-flto=full -C link-arg=-l:libamdlibm.a -Z threads=16" \
    CARGO_UNSTABLE_BUILD_STD="std,panic_abort" \
    CARGO_UNSTABLE_PROFILE_RUSTFLAGS="true" \
    CARGO_PROFILE_RELEASE_OPT_LEVEL="3" \
    CARGO_PROFILE_RELEASE_LTO="fat" \
    CARGO_PROFILE_RELEASE_CODEGEN_UNITS="1" \
    CARGO_PROFILE_RELEASE_PANIC="abort" \
    CARGO_PROFILE_RELEASE_STRIP="symbols" \
    CC="aoc" \
    CXX="aoc++" \
    AR="llvm-ar" \
    RANLIB="llvm-ranlib" \
    CFLAGS="-O3 -march=znver3 -mtune=znver3 -flto=full -ffast-math -zopt -fscalar-transform -floop-transform -faggressive-loop-transform -fremap-arrays -fstruct-layout=7 -fveclib=AMDLIBM" \
    CXXFLAGS="-O3 -march=znver3 -mtune=znver3 -flto=full -ffast-math -zopt -fscalar-transform -floop-transform -faggressive-loop-transform -fremap-arrays -fstruct-layout=7 -fveclib=AMDLIBM" \
    LDFLAGS="-fuse-ld=lld -flto=full -O3 -l:libamdlibm.a"

FROM builder AS compiler
WORKDIR /build
RUN git clone --depth 1 https://git.kernel.org/pub/scm/git/git.git /build/git && \
    cd /build/git && \
    make -j16 prefix=/usr NO_TCLTK=YesPlease \
      CC="aoc" AR="llvm-ar" RANLIB="llvm-ranlib" \
      CFLAGS="${CFLAGS}" LDFLAGS="${LDFLAGS}" && \
    make -j16 prefix=/usr NO_TCLTK=YesPlease DESTDIR=/out \
      CC="aoc" AR="llvm-ar" RANLIB="llvm-ranlib" \
      CFLAGS="${CFLAGS}" LDFLAGS="${LDFLAGS}" install && \
    llvm-strip --strip-unneeded /out/usr/bin/git* 2>/dev/null || true

FROM scratch AS export
COPY --from=compiler /out/ /
