# Project Firefly: kitty (Zen3+ / AOCC 6.0 + Go v3)
# Fedora 44 Builder
FROM fedora:44 AS builder

RUN dnf install -y \
  git \
  golang \
  gcc \
  make \
  pkgconf-pkg-config \
  python3-devel \
  harfbuzz-devel \
  zlib-devel \
  libpng-devel \
  lcms2-devel \
  librsync-devel \
  openssl-devel \
  freetype-devel \
  fontconfig-devel \
  libcanberra-devel \
  libxkbcommon-devel \
  libxkbcommon-x11-devel \
  wayland-devel \
  wayland-protocols-devel \
  mesa-libGL-devel \
  mesa-libEGL-devel \
  libX11-devel \
  libXrandr-devel \
  libXinerama-devel \
  libXcursor-devel \
  libXi-devel \
  vulkan-headers \
  dbus-devel \
  simde-devel \
  xxhash-devel \
  libquadmath \
  ncurses \
  && dnf clean all

COPY aocc-v6/aocc* /tmp/
RUN cat /tmp/aocc* > /tmp/aocc.rpm && \
    rpm -ivh --nodigest --nosignature /tmp/aocc.rpm && \
    rm -f /tmp/aocc*

ENV AOCC_DIR="/opt/AMD/aocc-compiler-6.0.0"
ENV PATH="${AOCC_DIR}/bin:${PATH}"
ENV LIBRARY_PATH="${AOCC_DIR}/lib:${AOCC_DIR}/lib32:${LIBRARY_PATH}"
ENV LD_LIBRARY_PATH="${AOCC_DIR}/lib:${AOCC_DIR}/lib32:${LD_LIBRARY_PATH}"
ENV C_INCLUDE_PATH="${AOCC_DIR}/include:${C_INCLUDE_PATH}"
ENV CPLUS_INCLUDE_PATH="${AOCC_DIR}/include:${CPLUS_INCLUDE_PATH}"

ENV GOPATH="/go" \
    GOMAXPROCS="16" \
    GOOS="linux" \
    GOARCH="amd64" \
    GOAMD64="v3" \
    CGO_ENABLED="1" \
    CC="aoc" \
    CXX="aoc++" \
    AR="llvm-ar" \
    RANLIB="llvm-ranlib" \
    CFLAGS="-O3 -march=znver3 -mtune=znver3 -zopt -fscalar-transform -floop-transform -faggressive-loop-transform -fremap-arrays -fstruct-layout=7 -fveclib=AMDLIBM" \
    CXXFLAGS="-O3 -march=znver3 -mtune=znver3 -zopt -fscalar-transform -floop-transform -faggressive-loop-transform -fremap-arrays -fstruct-layout=7 -fveclib=AMDLIBM" \
    LDFLAGS="-fuse-ld=lld -l:libamdlibm.a" \
    CGO_CFLAGS="-O3 -march=znver3 -mtune=znver3 -zopt -fscalar-transform -floop-transform -faggressive-loop-transform -fremap-arrays -fstruct-layout=7 -fveclib=AMDLIBM" \
    CGO_LDFLAGS="-fuse-ld=lld -l:libamdlibm.a"

FROM builder AS compiler
WORKDIR /build/kitty
RUN mkdir /out

RUN git clone --depth 1 https://github.com/kovidgoyal/kitty.git . && \
    python3 setup.py linux-package --prefix=/out/usr --update-check-interval=0 && \
    find /out/usr/bin /out/usr/lib*/kitty -type f \( -name "*.so" -o -executable \) -exec llvm-strip --strip-unneeded {} + 2>/dev/null || true

FROM scratch AS export
COPY --from=compiler /out/ /
