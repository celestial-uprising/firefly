# Project Firefly: Dive
# Fedora 44 + Zen3+ Builder
FROM fedora:44 AS builder
RUN dnf install -y \
    libquadmath \
    ncurses \
    golang \
    git \
    make \
    pkgconf-pkg-config \
    glibc-devel \
    && dnf clean all
COPY aocc-v6/aocc* /tmp/
RUN cat /tmp/aocc* > /tmp/aocc.rpm && \
    rpm -ivh --nodigest --nosignature /tmp/aocc.rpm && \
    rm -f /tmp/aocc*
ENV AOCC_DIR="/opt/AMD/aocc-compiler-6.0.0"
ENV PATH="${AOCC_DIR}/bin:${PATH}"
ENV LIBRARY_PATH="${AOCC_DIR}/lib:${AOCC_DIR}/lib32:${LIBRARY_PATH}"
ENV LD_LIBRARY_PATH="${AOCC_DIR}/lib:${AOCC_DIR}/lib32:${LD_LIBRARY_PATH}"
ENV GOPATH="/go" \
    GOBIN="/out/usr/bin" \
    GOMAXPROCS="16" \
    GOOS="linux" \
    GOARCH="amd64" \
    GOAMD64="v3" \
    CGO_ENABLED="0" \
    CC="aoc" \
    CXX="aoc++" \
    CGO_CFLAGS="-O3 -march=znver3 -mtune=znver3 -zopt -fvector-transform -fscalar-transform -floop-transform -faggressive-loop-transform -fremap-arrays -fstruct-layout=7 -fveclib=AMDLIBM" \
    CGO_CXXFLAGS="-O3 -march=znver3 -mtune=znver3 -zopt -fvector-transform -fscalar-transform -floop-transform -faggressive-loop-transform -fremap-arrays -fstruct-layout=7 -fveclib=AMDLIBM" \
    CGO_LDFLAGS="-fuse-ld=lld -l:libamdlibm.a"
RUN mkdir -p /out/usr/bin
FROM builder AS compiler
WORKDIR /build
RUN go install -trimpath -ldflags="-s -w" -tags containers_image_openpgp,exclude_graphdriver_btrfs github.com/wagoodman/dive@latest
FROM scratch AS export
COPY --from=compiler /out/ /
