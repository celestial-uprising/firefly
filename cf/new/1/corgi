# Project Firefly: Corgi
# Fedora 44 + Zen3+ Builder
FROM fedora:44 AS builder
RUN dnf install -y --setopt=tsflags=nodocs \
    git \
    curl \
    ca-certificates \
    xz \
    tar \
    llvm \
    lld \
    perl-Digest-SHA \
    && dnf clean all

ENV BUN_INSTALL="/root/.bun" \
    PATH="/root/.bun/bin:${PATH}" \
    ZIG_GLOBAL_CACHE_DIR="/tmp/zig-cache" \
    ZIG_LOCAL_CACHE_DIR="/tmp/zig-local-cache" \
    MAKEFLAGS="-j16" \
    RAYON_NUM_THREADS="16"

RUN curl -fsSL "https://bun.sh/install" | bash && \
    bun --version

FROM builder AS compiler
WORKDIR /build
RUN mkdir -p /out/usr/bin /out/usr/lib/corgi-native

RUN git clone --depth 1 https://github.com/tals/corgi.git /build/corgi
WORKDIR /build/corgi

# Inject -Dcpu=znver3 into the zig build args in build.ts
RUN bun -e ' \
  const fs = require("fs"); \
  let src = fs.readFileSync("build.ts", "utf8"); \
  const target = "\"\-Doptimize=ReleaseFast\"]"; \
  const replacement = "\"\-Doptimize=ReleaseFast\", \"\-Dcpu=znver3\"]"; \
  if (!src.includes(target)) throw new Error("Could not find -Doptimize=ReleaseFast args array in build.ts"); \
  src = src.replace(target, replacement); \
  fs.writeFileSync("build.ts", src, "utf8"); \
' && grep -n -- "-Dcpu=znver3" build.ts

# Build Corgi executable (dist/corgi) and native artifacts (native/zig-out)
RUN bun build.ts && \
    ls -la /build/corgi/dist && \
    cp -a /build/corgi/dist/corgi /out/usr/bin/corgi && \
    if [ -d /build/corgi/native/zig-out ]; then cp -a /build/corgi/native/zig-out/. /out/usr/lib/corgi-native/; fi && \
    find /out/usr -type f \( -executable -o -name "*.so*" \) -exec llvm-strip --strip-unneeded {} + 2>/dev/null || true && \
    for bin in /out/usr/bin/*; do \
      if [ -f "$bin" ] && [ -x "$bin" ] && head -c 4 "$bin" 2>/dev/null | grep -q $'\x7fELF'; then \
        echo "=== NEEDED: $(basename "$bin") ==="; \
        readelf -d "$bin" | awk '/NEEDED/ {print $5}' || true; \
      fi; \
    done && \
    find /out -maxdepth 4 -ls

FROM scratch AS export
COPY --from=compiler /out/ /
