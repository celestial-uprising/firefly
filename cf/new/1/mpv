# Project Firefly: MPV
# Fedora 44 Builder using custom ffmpeg + libplacebo (>=7.387.0) + AOCC 6.0 + Static Runtime Preference
FROM ghcr.io/celestial-uprising/firefly:FFMPEG AS ffmpeg-artifacts
FROM ghcr.io/celestial-uprising/firefly:LIBPLACEBO AS libplacebo-artifacts

FROM fedora:44 AS builder

RUN dnf install -y --setopt=tsflags=nodocs \
  git \
  gcc \
  gcc-c++ \
  libstdc++-devel \
  libstdc++-static \
  cmake \
  meson \
  ninja-build \
  pkgconf-pkg-config \
  libva-devel \
  openssl-devel \
  libass-devel \
  vulkan-devel \
  glslang-devel \
  spirv-tools-devel \
  libshaderc-devel \
  lcms2-devel \
  libdovi-devel \
  xxhash-devel \
  libxkbcommon-devel \
  wayland-devel \
  wayland-protocols-devel \
  mesa-libgbm-devel \
  libdrm-devel \
  libX11-devel \
  libXext-devel \
  libXrandr-devel \
  libXpresent-devel \
  pipewire-devel \
  alsa-lib-devel \
  libquadmath \
  libquadmath-static \
  lld \
  ncurses \
  && dnf clean all

COPY aocc-v6/aocc* /tmp/
RUN cat /tmp/aocc* > /tmp/aocc.rpm && \
    rpm -ivh --nodigest --nosignature /tmp/aocc.rpm && \
    rm -f /tmp/aocc*

ENV AOCC_DIR="/opt/AMD/aocc-compiler-6.0.0"
ENV PATH="${AOCC_DIR}/bin:${PATH}"
ENV LIBRARY_PATH="${AOCC_DIR}/lib:${AOCC_DIR}/lib32:${LIBRARY_PATH}"
ENV LD_LIBRARY_PATH="${AOCC_DIR}/lib:${AOCC_DIR}/lib32:${LD_LIBRARY_PATH}"
ENV C_INCLUDE_PATH="${AOCC_DIR}/include:${C_INCLUDE_PATH}"
ENV CPLUS_INCLUDE_PATH="${AOCC_DIR}/include:${CPLUS_INCLUDE_PATH}"

ENV CC="aoc" \
    CXX="aoc++" \
    LD="ld.lld" \
    AR="llvm-ar" \
    RANLIB="llvm-ranlib" \
    NM="llvm-nm" \
    STRIP="llvm-strip" \
    CFLAGS="-O3 -march=znver3 -mtune=znver3 -flto=full -zopt -fscalar-transform -floop-transform -faggressive-loop-transform -fremap-arrays -fstruct-layout=7 -fveclib=AMDLIBM" \
    CXXFLAGS="-O3 -march=znver3 -mtune=znver3 -flto=full -zopt -fscalar-transform -floop-transform -faggressive-loop-transform -fremap-arrays -fstruct-layout=7 -fveclib=AMDLIBM" \
    LDFLAGS="-fuse-ld=lld -flto=full -O3 -static-libstdc++ -static-libgcc -Wl,-O3,--gc-sections,--as-needed,--no-fatal-warnings -l:libamdlibm.a -lSPIRV-Tools -lSPIRV-Tools-opt"

FROM builder AS compiler
COPY --from=ffmpeg-artifacts /usr/ /usr/
COPY --from=libplacebo-artifacts /usr/ /usr/

ENV PKG_CONFIG_PATH="/usr/lib/pkgconfig:/usr/lib64/pkgconfig:${PKG_CONFIG_PATH}" \
    LIBRARY_PATH="/usr/lib:/usr/lib64:${LIBRARY_PATH}" \
    LD_LIBRARY_PATH="/usr/lib:/usr/lib64:${LD_LIBRARY_PATH}"

WORKDIR /build/mpv
RUN mkdir -p /out && \
    git clone --depth 1 https://github.com/mpv-player/mpv.git . && \
    meson setup build \
      --buildtype=release \
      --prefix=/usr \
      --bindir=bin \
      --libdir=lib64 \
      --prefer-static \
      -Db_lto=true \
      -Dwayland=enabled \
      -Dvulkan=enabled && \
    ninja -C build -j16 && \
    DESTDIR=/out ninja -C build install && \
    if [ -d /out/usr/sbin ] && [ ! -L /out/usr/sbin ]; then \
      mkdir -p /out/usr/bin && cp -a /out/usr/sbin/. /out/usr/bin/ && rm -rf /out/usr/sbin; \
    fi && \
    rm -rf /out/usr/include /out/usr/lib64/pkgconfig /out/usr/.crates.toml /out/usr/.crates2.json && \
    find /out/usr -type f \( -executable -o -name "*.so*" \) -exec llvm-strip --strip-unneeded {} + 2>/dev/null || true && \
    for bin in /out/usr/bin/*; do \
      if [ -f "$bin" ] && [ -x "$bin" ] && head -c 4 "$bin" 2>/dev/null | grep -q $'\x7fELF'; then \
        echo "=== NEEDED: $(basename "$bin") ==="; \
        readelf -d "$bin" | awk '/NEEDED/ {print $5}' || true; \
      fi; \
    done

FROM scratch AS export
COPY --from=compiler /out/ /
