# Project Firefly: Podman
# Fedora 44 + Zen3+ Builder (AOCC 6.0 + ld.lld + Static Runtime Preference)
FROM fedora:44 AS builder

RUN dnf install -y --setopt=tsflags=nodocs \
  git \
  golang \
  make \
  gcc \
  gcc-c++ \
  pkgconf-pkg-config \
  gpgme-devel \
  libassuan-devel \
  libseccomp-devel \
  device-mapper-devel \
  glib2-devel \
  libselinux-devel \
  systemd-devel \
  btrfs-progs-devel \
  go-md2man \
  libstdc++-devel \
  libstdc++-static \
  libquadmath \
  libquadmath-static \
  lld \
  ncurses \
  glibc-devel \
  sqlite-devel \
  shadow-utils-subid-devel \
  && dnf clean all

COPY aocc-v6/aocc* /tmp/
RUN cat /tmp/aocc* > /tmp/aocc.rpm && \
  rpm -ivh --nodigest --nosignature /tmp/aocc.rpm && \
  rm -f /tmp/aocc*

ENV AOCC_DIR="/opt/AMD/aocc-compiler-6.0.0"
ENV PATH="${AOCC_DIR}/bin:${PATH}"
ENV LIBRARY_PATH="${AOCC_DIR}/lib:${AOCC_DIR}/lib32:${LIBRARY_PATH}"
ENV LD_LIBRARY_PATH="${AOCC_DIR}/lib:${AOCC_DIR}/lib32:${LD_LIBRARY_PATH}"

ENV GOPATH="/go" \
  GOMAXPROCS="16" \
  GOOS="linux" \
  GOARCH="amd64" \
  GOAMD64="v3" \
  CGO_ENABLED="1" \
  CC="aoc" \
  CXX="aoc++" \
  LD="ld.lld" \
  AR="llvm-ar" \
  RANLIB="llvm-ranlib" \
  NM="llvm-nm" \
  STRIP="llvm-strip" \
  CGO_CFLAGS="-O3 -march=znver3 -mtune=znver3 -flto=full -zopt -fvector-transform -fscalar-transform -floop-transform -faggressive-loop-transform -fremap-arrays -fstruct-layout=7 -fveclib=AMDLIBM" \
  CGO_CXXFLAGS="-O3 -march=znver3 -mtune=znver3 -flto=full -zopt -fvector-transform -fscalar-transform -floop-transform -faggressive-loop-transform -fremap-arrays -fstruct-layout=7 -fveclib=AMDLIBM" \
  CGO_LDFLAGS="-fuse-ld=lld -static-libstdc++ -static-libgcc -Wl,-O3,-z,opt,--gc-sections,--as-needed,--no-fatal-warnings -l:libamdlibm.a"

FROM builder AS compiler
WORKDIR /tmp/podman-src

RUN mkdir -p /out && \
  git clone --depth 1 https://github.com/containers/podman.git . && \
  make BUILDTAGS="selinux seccomp systemd libsqlite3" binaries docs && \
  make BUILDTAGS="selinux seccomp systemd libsqlite3" \
    DESTDIR=/out \
    PREFIX=/usr \
    ETCDIR=/etc \
    install.bin \
    install.man \
    install.systemd \
    install.completions && \
    if [ -d /out/usr/sbin ] && [ ! -L /out/usr/sbin ]; then \
      mkdir -p /out/usr/bin && cp -a /out/usr/sbin/. /out/usr/bin/ && rm -rf /out/usr/sbin; \
    fi && \
    rm -rf /out/usr/include /out/usr/lib64/pkgconfig /out/usr/.crates.toml /out/usr/.crates2.json && \
    find /out/usr -type f \( -executable -o -name "*.so*" \) -exec llvm-strip --strip-unneeded {} + 2>/dev/null || true && \
    for bin in /out/usr/bin/*; do \
      if [ -f "$bin" ] && [ -x "$bin" ] && head -c 4 "$bin" 2>/dev/null | grep -q $'\x7fELF'; then \
        echo "=== NEEDED: $(basename "$bin") ==="; \
        readelf -d "$bin" | awk '/NEEDED/ {print $5}' || true; \
      fi; \
    done

FROM scratch AS export
COPY --from=compiler /out/ /
