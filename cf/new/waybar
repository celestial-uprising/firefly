# syntax=docker/dockerfile:1
# Target: x86_64 AMD Zen 3 (znver3) on Fedora 44 with AOCC 6.0 + ld.lld + AMDLIBM

FROM fedora:44 AS builder

RUN dnf install -y --setopt=tsflags=nodocs \
    file git curl ca-certificates make cmake ninja-build meson scdoc \
    pkgconf-pkg-config gcc gcc-c++ glibc-devel libstdc++-devel libstdc++-static \
    libquadmath libquadmath-static lld \
    && dnf clean all

COPY aocc-v6/aocc* /tmp/
RUN cat /tmp/aocc* > /tmp/aocc.rpm && \
    rpm -ivh --nodigest --nosignature /tmp/aocc.rpm && \
    rm -f /tmp/aocc*

ENV AOCC_DIR="/opt/AMD/aocc-compiler-6.0.0"
ENV PATH="${AOCC_DIR}/bin:${PATH}" \
    LIBRARY_PATH="${AOCC_DIR}/lib:${AOCC_DIR}/lib32:${LIBRARY_PATH}" \
    LD_LIBRARY_PATH="${AOCC_DIR}/lib:${AOCC_DIR}/lib32:${LD_LIBRARY_PATH}" \
    C_INCLUDE_PATH="${AOCC_DIR}/include:${C_INCLUDE_PATH}" \
    CPLUS_INCLUDE_PATH="${AOCC_DIR}/include:${CPLUS_INCLUDE_PATH}"

ENV CC="aoc" \
    CXX="aoc++" \
    LD="ld.lld" \
    AR="llvm-ar" \
    RANLIB="llvm-ranlib" \
    NM="llvm-nm" \
    STRIP="llvm-strip" \
    MAKEFLAGS="-j16" \
    CMAKE_BUILD_PARALLEL_LEVEL="16" \
    NINJA_STATUS="[%f/%t] "

FROM builder AS compiler

ARG REPO_URL=https://github.com/Alexays/Waybar.git
ARG REPO_REF=master

RUN dnf install -y --setopt=tsflags=nodocs \
    gobject-introspection-devel python3-packaging ncurses \
    'pkgconfig(date)' \
    'pkgconfig(dbusmenu-gtk3-0.4)' \
    'pkgconfig(fmt)' \
    'pkgconfig(gdk-pixbuf-2.0)' \
    'pkgconfig(gio-unix-2.0)' \
    'pkgconfig(gtk-layer-shell-0)' \
    'pkgconfig(gtkmm-3.0)' \
    'pkgconfig(jsoncpp)' \
    'pkgconfig(libgps)' \
    'pkgconfig(libinput)' \
    'pkgconfig(libmpdclient)' \
    'pkgconfig(libnl-3.0)' \
    'pkgconfig(libnl-genl-3.0)' \
    'pkgconfig(libpipewire-0.3)' \
    'pkgconfig(libudev)' \
    'pkgconfig(playerctl)' \
    'pkgconfig(sigc++-2.0)' \
    'pkgconfig(spdlog)' \
    'pkgconfig(systemd)' \
    'pkgconfig(upower-glib)' \
    'pkgconfig(wayland-client)' \
    'pkgconfig(wayland-cursor)' \
    'pkgconfig(wayland-protocols)' \
    'pkgconfig(wireplumber-0.5)' \
    'pkgconfig(xkbregistry)' \
    && dnf clean all

ENV GCC_DIR="/usr/lib/gcc/x86_64-redhat-linux/16"
ENV CFLAGS="-O3 -march=znver3 -mtune=znver3 -flto=full -zopt -fscalar-transform -floop-transform -faggressive-loop-transform -fremap-arrays -fstruct-layout=7 -fveclib=AMDLIBM --gcc-install-dir=${GCC_DIR}" \
    CXXFLAGS="-O3 -march=znver3 -mtune=znver3 -flto=full -zopt -fscalar-transform -floop-transform -faggressive-loop-transform -fremap-arrays -fstruct-layout=7 -fveclib=AMDLIBM --gcc-install-dir=${GCC_DIR}" \
    LDFLAGS="-fuse-ld=lld -flto=full -O3 -static-libstdc++ -static-libgcc -Wl,-O3,--gc-sections,--as-needed,--no-fatal-warnings -l:libamdlibm.a"

WORKDIR /build/src
RUN mkdir -p /out/usr/bin /out/usr/lib64 /out/usr/share && \
    git clone --depth 1 --branch "${REPO_REF}" "${REPO_URL}" . && \
    meson setup build \
      --prefix=/usr \
      --bindir=bin \
      --libdir=lib64 \
      --sbindir=bin \
      --buildtype=release \
      --prefer-static \
      -Db_lto=true \
      -Dcava=disabled \
      -Dpipewire=enabled \
      -Dpulseaudio=disabled \
      -Djack=disabled \
      -Dsndio=disabled \
      -Dlibevdev=disabled \
      -Dtests=disabled && \
    ninja -C build -j"$(nproc)" && \
    DESTDIR=/out ninja -C build install

# Normalize /out/usr/sbin -> /out/usr/bin, clean dev clutter, strip binaries, and inspect NEEDED libs
RUN if [ -d /out/usr/sbin ] && [ ! -L /out/usr/sbin ]; then \
      mkdir -p /out/usr/bin && cp -a /out/usr/sbin/. /out/usr/bin/ && rm -rf /out/usr/sbin; \
    fi && \
    rm -rf /out/usr/include /out/usr/lib64/pkgconfig && \
    if [ -d /out/usr ]; then \
      find /out/usr -type f \( -executable -o -name "*.so*" \) \
        -exec llvm-strip --strip-unneeded {} + 2>/dev/null || true; \
      for bin in /out/usr/bin/*; do \
        if [ -f "$bin" ] && [ -x "$bin" ] && file -b "$bin" | grep -q "ELF"; then \
          echo "=== NEEDED: $(basename "$bin") ==="; \
          readelf -d "$bin" | awk '/NEEDED/ {print $5}' || true; \
        fi; \
      done; \
    fi

FROM scratch AS export
COPY --from=compiler /out/ /
