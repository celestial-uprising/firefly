# Project Firefly: Rofi
# Fedora 44 + Zen3+ Builder (AOCC 6.0 + ld.lld + Static Runtime Preference)
FROM fedora:44 AS builder
RUN dnf install -y --setopt=tsflags=nodocs \
  gcc \
  gcc-c++ \
  libstdc++-devel \
  libstdc++-static \
  libquadmath \
  libquadmath-static \
  lld \
  ncurses \
  git \
  meson \
  ninja-build \
  pkgconf-pkg-config \
  flex \
  bison \
  check-devel \
  glib2-devel \
  pango-devel \
  cairo-devel \
  gdk-pixbuf2-devel \
  libxkbcommon-devel \
  wayland-devel \
  wayland-protocols-devel \
  && dnf clean all
COPY aocc-v6/aocc* /tmp/
RUN cat /tmp/aocc* > /tmp/aocc.rpm && \
    rpm -ivh --nodigest --nosignature /tmp/aocc.rpm && \
    rm -f /tmp/aocc*
ENV AOCC_DIR="/opt/AMD/aocc-compiler-6.0.0"
ENV PATH="${AOCC_DIR}/bin:${PATH}"
ENV LIBRARY_PATH="${AOCC_DIR}/lib:${AOCC_DIR}/lib32:${LIBRARY_PATH}"
ENV LD_LIBRARY_PATH="${AOCC_DIR}/lib:${AOCC_DIR}/lib32:${LD_LIBRARY_PATH}"
ENV C_INCLUDE_PATH="${AOCC_DIR}/include:${C_INCLUDE_PATH}"
ENV CPLUS_INCLUDE_PATH="${AOCC_DIR}/include:${CPLUS_INCLUDE_PATH}"
ENV CC="aoc" \
    CXX="aoc++" \
    AR="llvm-ar" \
    NM="llvm-nm" \
    RANLIB="llvm-ranlib" \
    STRIP="llvm-strip" \
    LD="ld.lld" \
    MAKEFLAGS="-j16" \
    CMAKE_BUILD_PARALLEL_LEVEL="16" \
    NINJA_STATUS="[%f/%t] "
ENV CFLAGS="-O3 -march=znver3 -mtune=znver3 -flto=full -zopt -fvector-transform -fscalar-transform -floop-transform -faggressive-loop-transform -fremap-arrays -fstruct-layout=7 -fveclib=AMDLIBM" \
    CXXFLAGS="-O3 -march=znver3 -mtune=znver3 -flto=full -zopt -fvector-transform -fscalar-transform -floop-transform -faggressive-loop-transform -fremap-arrays -fstruct-layout=7 -fveclib=AMDLIBM" \
    LDFLAGS="-fuse-ld=lld -flto=full -O3 -static-libstdc++ -static-libgcc -Wl,-O3,--gc-sections,--as-needed,--no-fatal-warnings -l:libamdlibm.a"
FROM builder AS compiler
WORKDIR /build
RUN mkdir -p /out/usr/bin /out/usr/lib64 /out/usr/share && \
    git clone --recursive https://github.com/davatorium/rofi.git && \
    meson setup rofi/build rofi \
        --prefix=/usr \
        --bindir=bin \
        --libdir=lib64 \
        --buildtype=release \
        --prefer-static \
        --strip \
        -Db_lto=true \
        -Dwayland=enabled \
        -Dxcb=disabled && \
    DESTDIR=/out ninja -C rofi/build install && \
    if [ -d /out/usr/sbin ] && [ ! -L /out/usr/sbin ]; then \
      mkdir -p /out/usr/bin && cp -a /out/usr/sbin/. /out/usr/bin/ && rm -rf /out/usr/sbin; \
    fi && \
    rm -rf /out/usr/include /out/usr/lib64/pkgconfig /out/usr/lib64/*.a /out/usr/lib/*.a /out/usr/.crates.toml /out/usr/.crates2.json && \
    find /out/usr -type f \( -executable -o -name "*.so*" \) -exec llvm-strip --strip-unneeded {} + 2>/dev/null || true && \
    for bin in /out/usr/bin/*; do \
      if [ -f "$bin" ] && [ -x "$bin" ] && head -c 4 "$bin" 2>/dev/null | grep -q $'\x7fELF'; then \
        echo "=== NEEDED: $(basename "$bin") ==="; \
        readelf -d "$bin" | awk '/NEEDED/ {print $5}' || true; \
      fi; \
    done

FROM scratch AS export
COPY --from=compiler /out/ /
